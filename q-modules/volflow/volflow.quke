        expect error message contains "not equity" for FX symbol
            err: .[.volflow.onUpdate;
                (`GBPUSD; 2026.05.10; 09:35:00.000t; .volflow.emptyT_; (); .volflow.emptyQ_);
                {x}];
            err like "*not equity*"

    should raise a q signal for unknown symbol UNKN

        expect error is raised for symbol not in instrument table
            .[.volflow.onUpdate;
                (`UNKN; 2026.05.10; 09:35:00.000t; .volflow.emptyT_; (); .volflow.emptyQ_);
                {1b}]

feature non-equity symbol rejected by calcDay (AC7)

