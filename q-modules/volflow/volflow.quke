// ---------------------------------------------------------------------------
// AC5 + AC8 — calcDay T+1 BATCH HAPPY PATH
// BDD Scenario: "Happy path — calcDay returns one row per traded bucket"
// [IMPL PENDING — calcDay currently returns ::]
// ---------------------------------------------------------------------------

feature calcDay T+1 batch happy path

    before
        if[not `onUpdate in key `.volflow; '"volflow not loaded — see setup_code in file header"]
        .volflow.cfg.reset[]

    should return a flat table when HDB has trade data for the symbol / date

        expect calcDay returns a table (type 98) for AAPL 2026.05.09
            98h = type .volflow.calcDay[`AAPL; 2026.05.09]

    should return results sorted ascending by bucket

        expect bucket column is sorted ascending
            r: .volflow.calcDay[`AAPL; 2026.05.09];
            r[`bucket] ~ asc r[`bucket]

    should return at least one row when trades exist

        expect at least one row in result for AAPL 2026.05.09
            0 < count .volflow.calcDay[`AAPL; 2026.05.09]

    should stamp every row with the requested date and sym

        expect every row has date = 2026.05.09
            r: .volflow.calcDay[`AAPL; 2026.05.09];
            all 2026.05.09 = r[`date]

        expect every row has sym = AAPL
            r: .volflow.calcDay[`AAPL; 2026.05.09];
            all `AAPL = r[`sym]

    should contain all 17 output columns

        expect 17 columns in calcDay result
            17 = count cols .volflow.calcDay[`AAPL; 2026.05.09]

    should have each compositeScore in [0f, 1f]

        expect all compositeScores in [0f, 1f]
            r: .volflow.calcDay[`AAPL; 2026.05.09];
            all {(not null x) and (x>=0f) and (x<=1f)} each r[`compositeScore]

    should have each signal value as one of +1h, 0h, -1h

        expect all signal values are valid short codes
            r: .volflow.calcDay[`AAPL; 2026.05.09];
            all r[`signal] in -1 0 1h


// ---------------------------------------------------------------------------
// AC4 + AC1 — STREAMING UPDATE HAPPY PATH
// BDD Scenario: "Happy path — update produces a complete signal row"
// [IMPL PENDING — update currently returns :: and does not populate state_]
// ---------------------------------------------------------------------------

feature streaming update happy path

    before
        if[not `onUpdate in key `.volflow; '"volflow not loaded — see setup_code in file header"]
        .volflow.cfg.reset[]
        .volflow.resetAll[]

    should return a result row when called with valid trade/quote delta tables

        expect onUpdate returns a table (not ::)
            r: .volflow.onUpdate[`AAPL; 2026.05.10; 09:35:00.000t;
                ([] time:09:30:01.000 09:31:01.000 09:32:01.000 09:33:01.000 09:34:01.000 09:35:01.000 09:36:01.000 09:37:01.000 09:38:01.000 09:39:01.000t;
                    price:100 101 102 103 104 105 106 107 108 109f;
                    size:100 200 150 300 100 250 100 200 300 150j;
                    side:`B`S`B`B`S`B`S`B`S`B);
                ();
                ([] sym:10#`AAPL; time:09:30:00.500 09:31:00.500 09:32:00.500 09:33:00.500 09:34:00.500 09:35:00.500 09:36:00.500 09:37:00.500 09:38:00.500 09:39:00.500t;
                    bid:10#99.5f; ask:10#100.5f; bsize:10#100j; asize:10#100j)];
            type[r] in 98 99h

    should accumulate intraday state for the symbol after calling update

        expect AAPL is present in state_ after an onUpdate call
            .volflow.resetAll[];
            .volflow.onUpdate[`AAPL; 2026.05.10; 09:35:00.000t;
                ([] time:09:30:01.000 09:31:01.000 09:32:01.000 09:33:01.000 09:34:01.000 09:35:01.000 09:36:01.000 09:37:01.000 09:38:01.000 09:39:01.000t;
                    price:100 101 102 103 104 105 106 107 108 109f;
                    size:100 200 150 300 100 250 100 200 300 150j;
                    side:`B`S`B`B`S`B`S`B`S`B);
                ();
                ([] sym:10#`AAPL; time:09:30:00.500 09:31:00.500 09:32:00.500 09:33:00.500 09:34:00.500 09:35:00.500 09:36:00.500 09:37:00.500 09:38:00.500 09:39:00.500t;
                    bid:10#99.5f; ask:10#100.5f; bsize:10#100j; asize:10#100j)];
            `AAPL in key .volflow.state_
