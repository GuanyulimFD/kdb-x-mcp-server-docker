// ============================================================================
// qcumber tests for rm-agent module (v0.4.0)
// Feature: AI Relationship Manager q analytics
//
// DB Service owns the data tables (rmag_ohlcv, rmag_news, etc.).
// Tests seed data directly into .rmag.* globals before each feature.
//
// Run via: kdbx_q_unit_test MCP tool
// ============================================================================

feature computeMetrics: compute Sharpe, CAGR, drawdown, vol

    before
        if[not `.rmag in key `.; system "l /Users/guanyulim/kdb-x-mcp-server/q-modules/rm-agent/rm-agent.q"];
        n:60;
        dates:(.z.d-n)+til n;
        prices:100f+0.5f*til n;
        `.rmag.rmag_ohlcv set ([]date:dates;sym:n#`AAPL;open:prices-0.5;high:prices+0.5;low:prices-0.8;close:prices;vol:n#50000000);

    should return a table with five metric columns
        expect result is a table
            98h = type .rmag.computeMetrics[enlist `AAPL; 90]

        expect all five metric columns present
            result: .rmag.computeMetrics[enlist `AAPL; 90];
            all (`cumulative_return`sharpe_ratio`max_drawdown`cagr`annualised_volatility) in cols result

        expect CAGR is positive for uptrending prices
            result: .rmag.computeMetrics[enlist `AAPL; 90];
            0f < first result`cagr

        expect max_drawdown is non-positive
            result: .rmag.computeMetrics[enlist `AAPL; 90];
            0f >= first result`max_drawdown

    should return empty table for single-observation symbol
        expect empty result when only 1 data point
            `.rmag.rmag_ohlcv set ([]date:enlist .z.d-1;sym:enlist `SOLO;open:enlist 50f;high:enlist 51f;low:enlist 49f;close:enlist 50f;vol:enlist 100000);
            0 = count .rmag.computeMetrics[enlist `SOLO; 90]

feature equityCurveData: cumulative return series for charting

    before
        if[not `.rmag in key `.; system "l /Users/guanyulim/kdb-x-mcp-server/q-modules/rm-agent/rm-agent.q"];
        n:30;
        dates:(.z.d-n)+til n;
        prices:100f+til n;
        `.rmag.rmag_ohlcv set ([]date:dates;sym:n#`TSLA;open:prices;high:prices+1;low:prices-1;close:prices;vol:n#30000000);

    should return a table with expected columns
        expect table has date sym cum_return_pct columns
            t: .rmag.equityCurveData[enlist `TSLA; 60];
            all (`date`sym`cum_return_pct) in cols t

    should start at 0 for first data point
        expect first cumulative return is 0 (rebased)
            t: `date xasc .rmag.equityCurveData[enlist `TSLA; 60];
            t: select from t where sym=`TSLA;
            .qu.compare[0f; first t`cum_return_pct]

    should return rows ordered by date
        expect dates are non-decreasing
            t: .rmag.equityCurveData[enlist `TSLA; 60];
            t[`date] ~ asc t[`date]

feature searchNews: rank and retrieve news articles

    before
        if[not `.rmag in key `.; system "l /Users/guanyulim/kdb-x-mcp-server/q-modules/rm-agent/rm-agent.q"];
        `.rmag.rmag_news set ([]ts:3#.z.p;sym:`AAPL`MSFT`AAPL;title:(`$"AAPL high";`$"MSFT cloud";`$"Macro risk");url:3#`$"http://a.com";source:3#`Reuters;published:3#`$"2024-01-02";summary:3#`$"text";sentiment:0.8 0.6 -0.3f;sentLabel:`Bullish`Bullish`Bearish);

    should return ranked results for known symbols
        expect searchNews returns at least 1 result for AAPL
            results: .rmag.searchNews[`AAPL`MSFT; `$""; 10];
            0<count results

    should return empty table when rmag_news is empty
        expect empty result when no news stored
            `.rmag.rmag_news set ([]ts:`timestamp$();sym:`$();title:`$();url:`$();source:`$();published:`$();summary:`$();sentiment:`float$();sentLabel:`$());
            results: .rmag.searchNews[`AAPL; `$""; 10];
            0=count results

feature getEvents: CEP event log delegation

    before
        if[not `.rmag in key `.; system "l /Users/guanyulim/kdb-x-mcp-server/q-modules/rm-agent/rm-agent.q"];
        if[not 0<count key `.cep; system "l /Users/guanyulim/kdb-x-mcp-server/q-modules/rm-agent/cep-engine.q"];
        `.cep.rmag_events set ([]evtId:`long$();ts:`timestamp$();sym:`$();evtType:`$();severity:`$();val:`float$();thrshVal:`float$();msg:`$());
        e1:enlist `evtId`ts`sym`evtType`severity`val`thrshVal`msg!(0Nj;.z.p;`AAPL;`PRICE_ALERT;`HIGH;6.5f;2.0f;`$"test1");
        .cep.appendEvents_[e1];

    should delegate to .cep.getEvents
        expect returns event table
            t: .rmag.getEvents[();();100];
            98h = type t

        expect at least one event
            0 < count .rmag.getEvents[();();100]

    should filter by sym
        expect filter by AAPL works
            1 = count .rmag.getEvents[enlist `AAPL;();100]
