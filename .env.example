# ---------------------------------------------------------------------------
# .env.example - copy to .env and fill in your credentials
#
# All three KX credentials are consumed at BUILD TIME to embed KDB-X and
# ax-libraries (qcumber) into the image.  Nothing secret is stored at runtime.
# ---------------------------------------------------------------------------

# ── KX bearer token (BUILD TIME - passed as a BuildKit secret) ───────────
# From the curl download command on your KX developer portal download page:
#   curl -sLO --oauth2-bearer <THIS_TOKEN> https://portal.dl.kx.com/...
# This token is NEVER written to any image layer or docker history.
KX_BEARER_TOKEN=<paste-your-bearer-token-here>

# ── Base64 KDB-X license key (BUILD TIME) ────────────────────────────────
# The --b64lic value from your KX installer command, e.g.:
#   bash install_kdb.sh --b64lic lUD61TYkyzj0...
KX_B64LIC=<paste-your-base64-license-here>

# ── Linux architecture ────────────────────────────────────────────────────
# l64     -> x86_64 (default)
# l64arm  -> aarch64 (AWS Graviton, ARM servers)
KX_ARCH=l64

# ── Runtime ports ─────────────────────────────────────────────────────────
MCP_HOST_PORT=8000
KDBX_DB_PORT=5001

# ── Logging ───────────────────────────────────────────────────────────────
# Host directory where the unified log file is written.
# Tail it with: tail -f ./logs/kdbx_mcp_*.log
LOG_DIR_HOST=./logs
# KDBX_MCP_LOG_LEVEL=INFO
